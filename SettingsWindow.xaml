<Window x:Class="EdgeGlow.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:EdgeGlow"
        Title="EdgeGlow" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14"
        TextOptions.TextFormattingMode="Ideal">

    <Window.Resources>
        <!-- Accent colour: overwritten at runtime with the user's Windows accent colour -->
        <SolidColorBrush x:Key="Accent" Color="#60CDFF"/>
        <SolidColorBrush x:Key="OnAccent" Color="#000000"/>

        <!-- ===== Title-bar caption buttons ===== -->
        <Style x:Key="CaptionBtn" TargetType="Border">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Background" Value="Transparent"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#22FFFFFF"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CloseBtn" TargetType="Border" BasedOn="{StaticResource CaptionBtn}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="CaptionGlyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="FontSize" Value="10"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Cards & text ===== -->
        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="#2B2B2B"/>
            <Setter Property="BorderBrush" Value="#363636"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="16,13"/>
            <Setter Property="Margin" Value="0,0,0,4"/>
        </Style>
        <Style x:Key="Section" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="Margin" Value="2,18,0,8"/>
        </Style>
        <Style x:Key="Title" TargetType="TextBlock">
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style x:Key="Sub" TargetType="TextBlock">
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>
        <Style x:Key="Sun" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets"/>
            <Setter Property="Foreground" Value="#A0A0A0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- ===== Slider (Fluent style) ===== -->
        <Style x:Key="SliderFillBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="{DynamicResource Accent}"
                                    VerticalAlignment="Center"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderEmptyBtn" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="SliderThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Grid Width="20" Height="20">
                            <Ellipse Fill="#454545" Stroke="#5E5E5E" StrokeThickness="1"/>
                            <Ellipse Width="10" Height="10" Fill="{DynamicResource Accent}"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="DarkSlider" TargetType="Slider">
            <Setter Property="Height" Value="24"/>
            <Setter Property="IsMoveToPointEnabled" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid Background="Transparent">
                            <Border Height="4" CornerRadius="2" Background="#767676" VerticalAlignment="Center"/>
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Style="{StaticResource SliderFillBtn}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Style="{StaticResource SliderEmptyBtn}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SliderThumbStyle}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Toggle switch (Windows style) ===== -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="40" Height="20" Background="Transparent" Cursor="Hand">
                            <Border x:Name="Track" CornerRadius="10" BorderThickness="1"
                                    BorderBrush="#CFCFCF" Background="Transparent"/>
                            <Ellipse x:Name="Knob" Width="12" Height="12" Fill="#CFCFCF"
                                     HorizontalAlignment="Left" Margin="4,0,0,0"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Accent}"/>
                                <Setter TargetName="Knob" Property="Fill" Value="{DynamicResource OnAccent}"/>
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,4,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Segmented choice (accent underline on selected) ===== -->
        <Style x:Key="Seg" TargetType="RadioButton">
            <Setter Property="Foreground" Value="#C8C8C8"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Grid Margin="2,2">
                            <Border x:Name="Bd" CornerRadius="4" Padding="4,7,4,10" Background="Transparent">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  TextElement.Foreground="{TemplateBinding Foreground}"/>
                            </Border>
                            <Rectangle x:Name="Ind" Height="3" Width="16" RadiusX="1.5" RadiusY="1.5"
                                       VerticalAlignment="Bottom" Margin="0,0,0,3"
                                       Fill="{DynamicResource Accent}" Visibility="Collapsed"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#0FFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#1FFFFFFF"/>
                                <Setter TargetName="Ind" Property="Visibility" Value="Visible"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ===== Thin scroll bar ===== -->
        <Style x:Key="ScrollThumb" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border CornerRadius="3" Background="#7A7A7A" Margin="2,0"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="ScrollPage" TargetType="RepeatButton">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Grid Background="Transparent"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Width" Value="10"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Style="{StaticResource ScrollPage}"/>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ScrollThumb}"/>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="10" CornerRadius="8" Background="#202020" BorderBrush="#3C3C3C" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="2" Opacity="0.5" Color="Black"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0" Height="32" Background="Transparent" MouseLeftButtonDown="OnTitleDrag">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <Ellipse Width="14" Height="14" StrokeThickness="2.5"
                             Stroke="{DynamicResource Accent}" VerticalAlignment="Center"/>
                    <TextBlock Text="EdgeGlow" FontSize="12" Foreground="White" Margin="9,0,0,0"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Border x:Name="ActiveBadge" VerticalAlignment="Center" Margin="0,0,10,0"
                            CornerRadius="4" Padding="9,2" BorderThickness="1"
                            Background="#2B2B2B" BorderBrush="#3A3A3A">
                        <TextBlock x:Name="ActiveText" Text="Idle" Foreground="#9D9D9D" FontSize="11.5"/>
                    </Border>
                    <Border Style="{StaticResource CaptionBtn}" MouseLeftButtonDown="OnMinClick">
                        <TextBlock Text="&#xE921;" Style="{StaticResource CaptionGlyph}"/>
                    </Border>
                    <Border Style="{StaticResource CloseBtn}" CornerRadius="0,8,0,0"
                            MouseLeftButtonDown="OnCloseClick">
                        <TextBlock Text="&#xE8BB;" Style="{StaticResource CaptionGlyph}"/>
                    </Border>
                </StackPanel>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20,6,20,22">

                    <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="White"
                               Margin="2,4,0,2"/>

                    <!-- ===== Light style ===== -->
                    <TextBlock Text="Light style" Style="{StaticResource Section}"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <TextBlock Text="Gradient" Style="{StaticResource Title}" VerticalAlignment="Center"/>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <RadioButton x:Name="OneRadio" GroupName="Grad" Content="1 Color"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                                <RadioButton x:Name="TwoRadio" GroupName="Grad" Content="2 Colors"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="Animation" Style="{StaticResource Title}"/>
                            <TextBlock Text="How the light moves around your screen" Style="{StaticResource Sub}"
                                       Margin="0,2,0,8"/>
                            <UniformGrid Columns="3">
                                <RadioButton x:Name="MusicRadio" GroupName="Anim" Content="Music Sync"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                                <RadioButton x:Name="SnakeRadio" GroupName="Anim" Content="Snake"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                                <RadioButton x:Name="StaticRadio" GroupName="Anim" Content="Static"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                                <RadioButton x:Name="AuroraRadio" GroupName="Anim" Content="Aurora"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                                <RadioButton x:Name="ChaseRadio" GroupName="Anim" Content="Chase"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                                <RadioButton x:Name="SparkleRadio" GroupName="Anim" Content="Sparkle"
                                             Style="{StaticResource Seg}" Checked="OnChanged"/>
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="ThicknessLabel" Text="Thickness" Style="{StaticResource Title}"/>
                                <TextBlock x:Name="ThicknessValue" HorizontalAlignment="Right" Style="{StaticResource Sub}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="16" Margin="0,8,0,0"
                                    Style="{StaticResource DarkSlider}" ValueChanged="OnChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="GlowLabel" Text="Glow" Style="{StaticResource Title}"/>
                                <TextBlock x:Name="GlowValue" HorizontalAlignment="Right" Style="{StaticResource Sub}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="GlowSlider" Minimum="10" Maximum="150" Margin="0,8,0,0"
                                    Style="{StaticResource DarkSlider}" ValueChanged="OnChanged"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <TextBlock x:Name="LengthLabel" Text="Snake length" Style="{StaticResource Title}"/>
                                <TextBlock x:Name="LengthValue" HorizontalAlignment="Right" Style="{StaticResource Sub}"
                                           VerticalAlignment="Center"/>
                            </Grid>
                            <Slider x:Name="LengthSlider" Minimum="0.1" Maximum="0.7" Margin="0,8,0,0"
                                    Style="{StaticResource DarkSlider}" ValueChanged="OnChanged"/>
                        </StackPanel>
                    </Border>

                    <!-- ===== Colors ===== -->
                    <TextBlock Text="Colors" Style="{StaticResource Section}"/>

                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Override album color" Style="{StaticResource Title}"/>
                                <TextBlock Text="Use your own colors instead of the album art" Style="{StaticResource Sub}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="OverrideBox" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="OnChanged" Unchecked="OnChanged"/>
                        </Grid>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <Grid x:Name="WheelsPanel">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="18"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <TextBlock HorizontalAlignment="Center">
                                    <Run Text="Primary" Foreground="White"/>
                                    <Run Text="&#160;&#160;60%" Foreground="#A0A0A0" FontSize="12"/>
                                </TextBlock>
                                <local:ColorWheel x:Name="PrimaryWheel" Width="130" Height="130" Margin="0,10,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE706;" FontSize="10" Style="{StaticResource Sun}"/>
                                    <Slider x:Name="PrimaryBright" Grid.Column="1" Minimum="0.1" Maximum="1" Margin="6,0"
                                            Style="{StaticResource DarkSlider}" ValueChanged="OnChanged"/>
                                    <TextBlock Grid.Column="2" Text="&#xE706;" FontSize="15" Style="{StaticResource Sun}"/>
                                </Grid>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <TextBlock HorizontalAlignment="Center">
                                    <Run Text="Secondary" Foreground="White"/>
                                    <Run Text="&#160;&#160;40%" Foreground="#A0A0A0" FontSize="12"/>
                                </TextBlock>
                                <local:ColorWheel x:Name="SecondaryWheel" Width="130" Height="130" Margin="0,10,0,10"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="&#xE706;" FontSize="10" Style="{StaticResource Sun}"/>
                                    <Slider x:Name="SecondaryBright" Grid.Column="1" Minimum="0.1" Maximum="1" Margin="6,0"
                                            Style="{StaticResource DarkSlider}" ValueChanged="OnChanged"/>
                                    <TextBlock Grid.Column="2" Text="&#xE706;" FontSize="15" Style="{StaticResource Sun}"/>
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!-- ===== Display ===== -->
                    <TextBlock Text="Display" Style="{StaticResource Section}"/>
                    <StackPanel x:Name="DisplayList"/>

                    <!-- ===== General ===== -->
                    <TextBlock Text="General" Style="{StaticResource Section}"/>
                    <Border Style="{StaticResource Card}">
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Start with Windows" Style="{StaticResource Title}"/>
                                <TextBlock Text="Launch EdgeGlow when you sign in" Style="{StaticResource Sub}"
                                           Margin="0,2,0,0"/>
                            </StackPanel>
                            <CheckBox x:Name="StartupBox" Style="{StaticResource Switch}"
                                      HorizontalAlignment="Right" VerticalAlignment="Center"
                                      Checked="OnChanged" Unchecked="OnChanged"/>
                        </Grid>
                    </Border>

                </StackPanel>
            </ScrollViewer>
        </Grid>
    </Border>
</Window>
